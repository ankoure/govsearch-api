# Application Settings
APP_NAME=GovSearch API
APP_VERSION=1.0.0
APP_DESCRIPTION=Semantic and keyword search API for government websites
DEBUG=false

# CORS Settings
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# OpenSearch Settings
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX=govsites
OPENSEARCH_TIMEOUT=30
OPENSEARCH_HTTP_COMPRESS=true

# Embedding Model Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Search Settings
DEFAULT_SEARCH_SIZE=10
MAX_SEARCH_SIZE=100
DEFAULT_KEYWORD_WEIGHT=0.6
DEFAULT_CHUNKS_TO_RETURN=3
KNN_K=5

# Ollama LLM Settings (Optional)
# Set OLLAMA_ENABLED=true to enable LLM features
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_MAX_CHUNKS_FOR_CONTEXT=5
